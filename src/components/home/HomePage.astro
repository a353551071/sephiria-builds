---
/**
 * HomePage — renders the homepage from the locale JSON `home` namespace.
 *
 * Data-driven: changing src/locales/en.json updates the homepage without
 * touching this component.
 *
 * Sections (top to bottom):
 *   1. Hero          — title, description, CTAs (strong visual anchor)
 *   2. QuickStart    — 4 large icon cards (Codes / Bosses / Guides / Tier)
 *   3. Recent Updates + Trending links (two columns)
 *   4. Explore       — 4 content modules with displayTypes
 *   5. ClosingCta      — bottom call-to-action
 *
 * v0.2 refactor: trimmed from 8 sections to 5. Removed GameInfo (info
 * duplicated Hero stats), FAQ (moved to /faq), standalone TrendingNow
 * (merged into Recent Updates). Explore modules trimmed 8→4. Page length
 * compressed from ~7 screens to ~4.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import VideoSection from '~/components/home/VideoSection.astro';
import HomeStats from '~/components/home/HomeStats.astro';
import QuickStart from '~/components/home/QuickStart.astro';
import ExploreModules from '~/components/home/ExploreModules.astro';
import { site } from '~/config/site';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { getRecentEntries, parseEntryId } from '~/lib/content';
import { localizePath, listPath, detailPath } from '~/lib/url';

interface Props {
  locale: Locale;
  jsonLd?: Record<string, unknown>[];
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, jsonLd = [], alternates = [] } = Astro.props;
const ui = getUi(locale);
const home = ui.home as any;
const shared = ui.shared as unknown as Record<string, any>;

const recent = await getRecentEntries(locale, 6);

const meta = home.meta ?? { title: site.name, description: site.description };
const hero = home.hero ?? {};
// Shape-only defaults: getUi() deep-merges over en.json, so titles/labels are
// guaranteed present — no hardcoded English fallbacks (UI text lives in the
// locale JSON per the template's own rule).
const updates = home.updates ?? {};
const start = home.start ?? { cards: [] };
const popular = home.popular ?? { quickLinks: [] };
const explore = home.explore ?? { modules: [] };
const closingCta = home.closingCta ?? {};

// QuickLink may be a string or { label, href } — normalize for the sidebar list.
type QuickLink = string | { label: string; href: string };
const trendingLinks: QuickLink[] = Array.isArray(popular.quickLinks) ? popular.quickLinks : [];
function trendingHref(link: QuickLink): string | null {
  return typeof link === 'string' ? null : localizePath(link.href, locale);
}
function trendingLabel(link: QuickLink): string {
  return typeof link === 'string' ? link : link.label;
}
---

<LocaleLayout
  locale={locale}
  title={meta.title}
  description={meta.description}
  alternates={alternates}
  jsonLd={jsonLd}
>
  {/* ─────────────────────────────── Hero ─────────────────────────────── */}
  <section class="relative overflow-hidden border-b border-border">
    {/* Official keyart — wide press-kit art as the atmospheric base layer,
        faded + masked so text contrast survives. Art © Team Horay. */}
    <img
      src="/images/brand/sephiria-keyart-wide.png"
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center opacity-45"
      style="mask-image:linear-gradient(to bottom, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.55) 55%, transparent 100%);-webkit-mask-image:linear-gradient(to bottom, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.55) 55%, transparent 100%)"
    />
    {/* Hero backdrop — blueprint grid + gold wash + ice glow, one composited
        layer (sp-hero-bg) so no image asset is introduced. */}
    <div aria-hidden="true" class="sp-hero-bg pointer-events-none absolute inset-0" />
    <div class="relative mx-auto grid w-full max-w-7xl items-center gap-12 px-4 py-16 md:py-20 lg:grid-cols-[1.35fr_1fr] lg:py-24">
      {/* Left: badge / title / description / CTAs */}
      <div>
        <p class="font-pixel text-[10px] uppercase tracking-[0.18em] text-nav">{hero.badge}</p>
        <h1
          class="hero-title mt-4 max-w-3xl text-4xl tracking-tight text-foreground sm:text-5xl md:text-6xl lg:text-7xl"
          style="font-family:var(--sp-font-display);font-weight:700"
        >
          {hero.title}
        </h1>
        {/* Gold title rule — the in-game heading divider language */}
        <span
          aria-hidden="true"
          class="mt-5 block h-[2px] w-24 origin-left"
          style="background:linear-gradient(90deg,hsl(var(--sp-gold)),hsl(var(--sp-gold) / 0))"
        ></span>
        <p class="mt-5 max-w-xl text-base text-muted-foreground md:text-lg">{hero.description}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          {
            hero.ctaPrimary && (
              <a
                href={site.social.official}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary"
              >
                <Icon name="lucide:play" class="mr-2 h-4 w-4" />
                {hero.ctaPrimary}
              </a>
            )
          }
          {
            hero.ctaSecondary && (
              <a
                href={hero.ctaSecondaryHref ? localizePath(hero.ctaSecondaryHref, locale) : listPath(NAVIGATION_CONFIG[1]?.key ?? 'guides', locale)}
                class="btn-outline"
              >
                {hero.ctaSecondary}
              </a>
            )
          }
        </div>
      </div>

      {/* Right: official game art — the game-native anchor of the hero
          (library capsule from the Steam store, same asset the player knows). */}
      <div class="relative mx-auto w-full max-w-xs lg:max-w-sm">
        <div class="sp-gold-ring overflow-hidden rounded-lg border-2 shadow-2xl shadow-black/50">
          <img
            src="/images/sephiria-library.jpg"
            alt="Official Sephiria game art by Team Horay"
            width="600"
            height="900"
            class="aspect-[2/3] w-full object-cover"
            loading="eager"
          />
        </div>
        {/* Version chip — sp-patch language (patch discipline), re-tinted for
            the keyart: dark gold-ink field + bright gold text, stable on the
            dark game art in both themes. */}
        <span
          class="sp-patch absolute -bottom-3 right-3"
          style="background:hsl(var(--sp-gold-ink));color:hsl(var(--brand-light))"
        >
          v{hero.versionChip ?? '1.0.30'}
        </span>
      </div>
    </div>
  </section>

  {/* Trailer — only renders when a videoId is configured. */}
  {hero.videoId && <VideoSection videoId={hero.videoId} title={`${site.game.name} trailer`} />}

  {/* By-the-numbers banner — taskbarhero-style stat strip. */}
  <HomeStats locale={locale} />

  {/* ───────────────────────────── Quick Start ────────────────────────── */}
  <QuickStart
    locale={locale}
    badge={start.badge}
    title={start.title}
    cards={start.cards}
  />

  {/* ───────────────────── Recent Updates + Trending ───────────────────── */}
  <section class="section border-t border-border">
    <div class="grid gap-8 lg:grid-cols-3">
      {/* Recent updates — 2/3 width on desktop. */}
      <div class="lg:col-span-2">
        <div class="sp-section-head">
          <div>
            <p class="sp-kicker">{updates.badge}</p>
            <h2 class="mt-1 text-2xl font-bold">{updates.title}</h2>
          </div>
          <a href={listPath(NAVIGATION_CONFIG[1]?.key ?? 'guides', locale)} class="text-sm text-foreground hover:text-nav hover:underline"
            >{shared.browseAll}</a
          >
        </div>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {
            recent.length === 0 ? (
              <p class="text-sm text-muted-foreground">{shared.noArticles}</p>
            ) : (
              recent.map((entry) => {
                const parsed = parseEntryId(entry.id);
                if (!parsed) return null;
                return (
                  <a href={detailPath(parsed.category, parsed.slug, locale)} class="sp-card p-4">
                    <div class="flex items-center justify-between gap-2">
                      <p class="text-xs uppercase tracking-wider text-muted-foreground">
                        {parsed.category}
                      </p>
                      {entry.data.gameVersion && (
                        <span
                          class="font-pixel rounded-sm border border-nav/40 bg-nav/10 px-1.5 py-0.5 text-[9px] uppercase text-nav"
                          title={`${shared.gameVersion}: ${entry.data.gameVersion}`}
                        >
                          v{entry.data.gameVersion}
                        </span>
                      )}
                    </div>
                    <h3 class="mt-1 font-semibold leading-snug">{entry.data.title}</h3>
                    <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
                      {entry.data.description}
                    </p>
                  </a>
                );
              })
            )
          }
        </div>
      </div>

      {/* Trending — 1/3 width sidebar list. */}
      {trendingLinks.length > 0 && (
        <aside>
          <p class="sp-kicker">{popular.badge}</p>
          <h2 class="mt-1 text-2xl font-bold">{popular.title}</h2>
          <ul class="mt-4 space-y-2">
            {trendingLinks.map((link: QuickLink) => {
              const href = trendingHref(link);
              const label = trendingLabel(link);
              return (
                <li>
                  {href ? (
                    <a
                      href={href}
                      class="sp-card flex items-center gap-2 p-3 text-sm font-medium"
                    >
                      <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                      <span class="leading-snug">{label}</span>
                    </a>
                  ) : (
                    <div class="sp-card flex items-center gap-2 p-3 text-sm font-medium">
                      <Icon name="lucide:trending-up" class="h-4 w-4 shrink-0 text-nav" />
                      <span class="leading-snug">{label}</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        </aside>
      )}
    </div>
  </section>

  {/* ──────────────────────────── Explore Modules ─────────────────────── */}
  {
    explore.modules?.length > 0 && (
      <section class="section border-t border-border">
        <header class="sp-section-head">
          <div>
            <p class="sp-kicker">{explore.badge}</p>
            <h2 class="mt-1 text-2xl font-bold">{explore.title}</h2>
            {/* Ice accent — the Glacier/Verification secondary color lands here. */}
            <p class="mt-1 text-sm" style="color:hsl(var(--sp-ice))">{explore.description}</p>
          </div>
        </header>
        <div class="mt-8">
          <ExploreModules modules={explore.modules} locale={locale} />
        </div>
      </section>
    )
  }

  {/* ─────────────────────────────── Final CTA ────────────────────────── */}
  {
    closingCta.title && (
      <section class="section border-t border-border">
        <div class="rounded-xl border bg-card p-8 text-center md:p-12">
          <p class="sp-kicker">{closingCta.badge}</p>
          <h2 class="mt-2 text-2xl font-bold md:text-3xl">{closingCta.title}</h2>
          <p class="mx-auto mt-2 max-w-xl text-muted-foreground">{closingCta.description}</p>
          <div class="mt-6 flex justify-center gap-3">
            <a
              href={site.social.official}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              {closingCta.primary}
            </a>
            {closingCta.secondary && site.social.discord && (
              <a
                href={site.social.discord}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline"
              >
                {closingCta.secondary}
              </a>
            )}
          </div>
        </div>
      </section>
    )
  }
</LocaleLayout>
