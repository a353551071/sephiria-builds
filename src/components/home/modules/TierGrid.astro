---
/**
 * Tier-grid displayType — S/A/B/C ranked items.
 * Used for tier lists on the homepage.
 */
import { TIER_COLORS, TIER_FALLBACK } from '~/lib/tier';

interface Props {
  highlights: Array<{ label: string; detail: string }>;
}
const { highlights } = Astro.props;
---

<div class="space-y-2">
  {
    highlights.map((h) => (
      <div class="flex items-center gap-3 rounded-md border bg-card p-3">
        <span
          class:list={[
            'font-pixel flex h-8 w-8 shrink-0 items-center justify-center rounded-sm text-sm',
            TIER_COLORS[h.label] ?? TIER_FALLBACK,
          ]}
        >
          {h.label}
        </span>
        <p class="text-sm text-muted-foreground">{h.detail}</p>
      </div>
    ))
  }
</div>
