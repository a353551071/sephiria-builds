---
/**
 * LazyYouTube — crawlable lazy YouTube embed (v1.9.0).
 *
 * Used by BOTH the homepage VideoSection and the MDX inline <Video>
 * component (plus the article-bottom fallback in ArticlePage).
 *
 * v1.9.0 — replaced the click-to-load thumbnail facade with a native
 * `loading="lazy"` iframe. The old facade saved ~500KB of YouTube JS on
 * initial paint, but the served HTML contained no <video>/<iframe> at all —
 * Google's video systems couldn't verify the embed, and GSC flagged the
 * VideoObject pages as "video not on watch page" (WNC-10030260, 2026-09-09).
 * A native lazy iframe keeps the deferred-load benefit AND puts a real,
 * crawler-visible embed in the static HTML.
 *
 * The caption link under the embed (in Video.astro) doubles as an HTML
 * anchor to the video URL — belt and suspenders for video association.
 */
interface Props {
  /** 11-char YouTube video ID. */
  videoId: string;
  /** Title for the iframe's accessibility label. */
  title?: string;
}

const { videoId, title = 'Watch video' } = Astro.props;
---

<div class="relative aspect-video w-full overflow-hidden rounded-lg bg-black">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0`}
    title={title}
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    class="absolute inset-0 h-full w-full border-0"
  ></iframe>
</div>
